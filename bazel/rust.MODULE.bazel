"""The Rust toolchain: one compiler, every target triple a front end needs."""

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_target_triples = [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        # The command line for Windows, built on Linux: the GNU ABI,
        # which the LLVM toolchain links with MinGW-w64's runtime, so no
        # Microsoft SDK is needed.
        "x86_64-pc-windows-gnullvm",
        # Web
        "wasm32-unknown-unknown",
    ],
    versions = ["1.98.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")
