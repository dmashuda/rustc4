"""rustc4: C4-style architecture diagrams as code. One Rust core, many targets.

The toolchains live in bazel/*.MODULE.bazel, pulled in by the include() calls
at the bottom. The layout is med-log's (github.com/dmashuda/med-log), minus
the native app toolchains until there is a native app.

  * apple_support is depended on before rules_cc, because Bazel takes the
    first registered C/C++ toolchain and only apple_support's targets macOS
    properly.
  * register_toolchains() precedence follows the order the calls are reached:
    Rust, then LLVM (Linux and wasm).
"""

module(name = "rustc4")

bazel_dep(name = "apple_support", version = "2.10.1")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "rules_rust", version = "0.74.0")

# Order matters: see the docstring above.
include("//bazel:rust.MODULE.bazel")
include("//bazel:cc_linux.MODULE.bazel")
include("//bazel:crates.MODULE.bazel")
include("//bazel:web.MODULE.bazel")
