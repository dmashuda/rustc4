load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("//tools/apple:defs.bzl", "APPLE_TARGET_COMPATIBLE_WITH")

# SwiftUI views + model for the Apple apps. Depends only on the UniFFI Swift
# module; the Rust code arrives transitively via CcInfo.
swift_library(
    name = "C4UI",
    srcs = glob(["Sources/*.swift"]),
    module_name = "C4UI",
    target_compatible_with = APPLE_TARGET_COMPATIBLE_WITH,
    visibility = ["//apps:__subpackages__"],
    deps = ["//bindings/uniffi:C4FFI"],
)

swift_library(
    name = "C4UITestsLib",
    testonly = True,
    srcs = glob(["tests/*.swift"]),
    target_compatible_with = APPLE_TARGET_COMPATIBLE_WITH,
    deps = [":C4UI"],
)

macos_unit_test(
    name = "C4UITests",
    # Mostly xctest start-up.
    size = "medium",
    minimum_os_version = "14.0",
    target_compatible_with = APPLE_TARGET_COMPATIBLE_WITH,
    deps = [":C4UITestsLib"],
)
